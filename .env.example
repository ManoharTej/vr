# StyleSpeak — Environment Variables
# Copy this file to .env and fill in values.
# The application runs fully without any API keys — these are for future extensions.

# ─── Backend ───────────────────────────────────────────────
# Port for the FastAPI server (default: 8000)
BACKEND_PORT=8000

# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite:///./stylespeak.db

# Allowed CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*

# Upload directory (relative to backend/)
UPLOAD_DIR=uploads

# Maximum upload file size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE=10485760

# ─── AI Try-On (optional, future) ──────────────────────────
# Set TRYON_MODE=demo for SVG overlay (default, no model needed)
# Set TRYON_MODE=ai to enable AI inference (requires model files)
TRYON_MODE=demo

# Path to pretrained virtual try-on model (optional)
# VTON_MODEL_PATH=./models/idm_vton.pt

# ─── External APIs (all optional) ──────────────────────────
# OpenAI key for LLM-enhanced recommendations (future)
# OPENAI_API_KEY=sk-...

# Cloud storage (AWS S3, optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=stylespeak-uploads
# AWS_REGION=ap-south-1

